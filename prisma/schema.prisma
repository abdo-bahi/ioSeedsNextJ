// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Wilaya  ───────────────────────────────────────────

model Wilaya {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String        @unique // reverse relations
  users        User[]
  farmingUnits FarmingUnit[]
}
// ─── Auth (NextAuth.js) ───────────────────────────────────────────

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  address       String?
  password      String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  fk_wilaya     String?
  wilaya        Wilaya?      @relation(fields: [fk_wilaya], references: [id], onDelete: SetNull)
  fk_farm       String?
  farm          FarmingUnit? @relation("FarmMembers", fields: [fk_farm], references: [id], onDelete: SetNull)
  isActive      Boolean      @default(true)

  // reverse relations
  // User owns these farms
  ownedFarms     FarmingUnit[]   @relation("FarmOwner")
  roleMembers    RoleMember[]
  auditLogs      AuditLog[]
  connectionLogs ConnectionLog[]
  schedule       Schedule[]
  sessions       Session[]
  accounts       Account[]

  role       String?
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  @@map("user")
}

model Role {
  name     String  @id
  isActive Boolean @default(true)

  // reverse relations
  members         RoleMember[]
  functionalities Role_Functionality[]
}

model RoleMember {
  id      String  @id @default(cuid())
  fk_role String
  role    Role    @relation(fields: [fk_role], references: [name], onDelete: Cascade)
  fk_user String?
  user    User?   @relation(fields: [fk_user], references: [id], onDelete: Cascade)

  fk_irrigationField String?
  irrigationField    IrrigationField? @relation(fields: [fk_irrigationField], references: [id], onDelete: Cascade)

  // one row per role+functionality combo
  @@unique([fk_user, fk_role, fk_irrigationField])
}

model Functionality {
  name                String               @id // "devices", "zones", "schedules", "reports"
  // reverse relations
  roleFunctionalities Role_Functionality[]
}

model Role_Functionality {
  id               String        @id @default(cuid())
  fk_role          String
  role             Role          @relation(fields: [fk_role], references: [name], onDelete: Cascade)
  fk_functionality String
  functionality    Functionality @relation(fields: [fk_functionality], references: [name], onDelete: Cascade)

  canCreate Boolean @default(false)
  canRead   Boolean @default(true)
  canUpdate Boolean @default(false)
  canDelete Boolean @default(false)
  // one row per role+functionality combo

  @@unique([fk_role, fk_functionality])
}

model AuditLog {
  id         String      @id @default(cuid())
  dateTime   DateTime    @default(now())
  tableName  String
  rowId      String
  crudAction AuditAction
  oldValue   Json?
  newValue   Json?
  fk_user    String?
  user       User?       @relation(fields: [fk_user], references: [id], onDelete: Restrict)
}

model ConnectionLog {
  id        String   @id @default(cuid())
  dateTime  DateTime @default(now())
  ipAddress String
  fk_user   String?
  user      User?    @relation(fields: [fk_user], references: [id], onDelete: Restrict)
  success   Boolean  @default(true) // ← add this, useful for detecting brute force
}

// ─── IoT Domain ──────────────────────────────────────────────────

model FarmingUnit {
  id          String   @id @default(cuid())
  name        String?
  address     String?
  description String?
  isActive    Boolean
  createdAt   DateTime @default(now())
  contact     String?

  fk_wilaya        String?
  wilaya           Wilaya?           @relation(fields: [fk_wilaya], references: [id], onDelete: SetNull)
  fk_owner         String?
  owner            User?             @relation("FarmOwner", fields: [fk_owner], references: [id], onDelete: SetNull)
  // reverse relations
  irrigationFields IrrigationField[]
  users            User[]            @relation("FarmMembers")

  @@unique([fk_owner, name])
}

model IrrigationField {
  id             String       @id @default(cuid())
  name           String?
  crop           String?
  surface        Float?
  latitude       Float
  longitude      Float
  isActive       Boolean
  createdAt      DateTime     @default(now())
  fk_FarmingUnit String
  FarmingUnit    FarmingUnit  @relation(fields: [fk_FarmingUnit], references: [id], onDelete: Cascade)
  // reverse relations
  members        RoleMember[]
  mcu            MCU[]

  @@unique([fk_FarmingUnit, name])
}

model MCU {
  id                       String    @id @default(cuid())
  name                     String?
  minSoilMoisture          Float
  maxSoilMoisture          Float
  sleepingTime             Float
  macAddress               String?
  autoControlledIrrigation Boolean
  isActive                 Boolean
  apiKeyHash               String
  status                   MCUStatus
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  fk_irrigationField String
  irrigationField    IrrigationField @relation(fields: [fk_irrigationField], references: [id], onDelete: Cascade)

  // reverse relations
  sensors   Sensor[]
  actuators Actuator[]

  @@unique([fk_irrigationField, name])
}

model SensorType {
  name        String   @id
  description String?
  // reverse relations
  sensors     Sensor[]
}

model ActuatorType {
  name        String  @id
  description String?

  // reverse relations
  actuators Actuator[]
}

model Sensor {
  id          String   @id @default(cuid())
  name        String
  macAddress  String?
  latitude    Float
  longitude   Float
  minAnalogue Float
  maxAnalogue Float
  createdAt   DateTime @default(now())
  isActive    Boolean

  fk_mcu        String?
  mcu           MCU?        @relation(fields: [fk_mcu], references: [id], onDelete: SetNull)
  fk_sensorType String?
  sensorType    SensorType? @relation(fields: [fk_sensorType], references: [name], onDelete: SetNull)

  // reverse relations
  environmentData EnvironmentData[]

  @@unique([fk_mcu, name])
}

model Actuator {
  id          String   @id @default(cuid())
  name        String
  macAddress  String?
  latitude    Float
  longitude   Float
  targetState Boolean
  createdAt   DateTime @default(now())
  isActive    Boolean

  fk_mcu          String?
  mcu             MCU?          @relation(fields: [fk_mcu], references: [id], onDelete: SetNull)
  fk_actuatorType String?
  actuatorType    ActuatorType? @relation(fields: [fk_actuatorType], references: [name], onDelete: SetNull)

  // reverse relations
  actions   Actions[]
  schedules Schedule[]

  @@unique([fk_mcu, name])
}

model EnvironmentData {
  id        String   @id @default(cuid())
  value     Float
  unit      String
  rawValue  Float?
  createdAt DateTime @default(now())
  fk_sensor String
  sensor    Sensor   @relation(fields: [fk_sensor], references: [id], onDelete: Cascade)

  fk_action String?
  action    Actions? @relation(fields: [fk_action], references: [id], onDelete: SetNull)
}

model Actions {
  id        String  @id @default(cuid())
  actionVal Boolean

  createdAt       DateTime          @default(now())
  sentAt          DateTime?
  ackedAt         DateTime?
  fk_actuator     String
  actuator        Actuator          @relation(fields: [fk_actuator], references: [id], onDelete: Cascade) // reverse relations
  environmentData EnvironmentData[]
}

model Schedule {
  id                 String    @id @default(cuid())
  name               String
  repeatEveryDays    Int
  duration           Int
  isActive           Boolean   @default(true)
  startAt            DateTime?
  startDate          DateTime?
  endDate            DateTime?
  weekDays           Days[]
  toggleAtThresholds Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fk_actuator String
  actuator    Actuator @relation(fields: [fk_actuator], references: [id], onDelete: Cascade)
  fk_creator  String?
  creator     User?    @relation(fields: [fk_creator], references: [id], onDelete: SetNull)

}

// ─── Enums ───────────────────────────────────────────────────────

enum AuditAction {
  INSERT
  UPDATE
  DELETE
}

enum Days {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum MCUStatus {
  ONLINE
  OFFLINE
  SLEEPING
  ERROR
}

// new 5/8/2026

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  @@index([userId])
  @@map("session")
}

model Account {
  id         String @id
  accountId  String
  providerId String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken  String?
  refreshToken String?

  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?

  scope String?

  idToken String?

  password String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
